    "### Minimal Data Cleaning"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 25,
   "id": "983cef31-b76d-49bb-8252-84d2a21561b9",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Target column renaming\n",
    "def clean_data(df):\n",
    "    df = df.rename(columns={\"Class\": \"Target\"})\n",
    "    return df\n",
    "\n",
    "df = clean_data(df)"
   ]
  },
  {
   "cell_type": "markdown",
