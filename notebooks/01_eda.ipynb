    "def check_data(df):\n",
    "    import pandas as pd\n",
    "    \n",
    "    # Build summary table\n",
    "    summary = pd.DataFrame({\n",
    "        \"Data Type\": df.dtypes,\n",
    "        \"Non‑Null Count\": df.notnull().sum(),\n",
    "        \"Missing Count\": df.isnull().sum(),\n",
    "    })\n",
    "\n",
    "    summary[\"Missing %\"] = (summary[\"Missing Count\"] / len(df) * 100).round(2)\n",
    "\n",
    "    # add unique counts (comment out if not needed)\n",
    "    summary[\"Unique Values\"] = df.nunique()\n",
    "\n",
    "    # add example values (comment out if not needed)\n",
    "    summary[\"Example Value\"] = df.apply(lambda x: x.dropna().iloc[0] if x.dropna().size > 0 else None)\n",
    "\n",
    "    # Display\n",
    "    print(\"\\n=================== DATA SUMMARY ===================\")\n",
    "    print(f\"Shape: {df.shape}\\n\")\n",
    "    return summary\n",
    "check_data(df)"
   ]
  },
