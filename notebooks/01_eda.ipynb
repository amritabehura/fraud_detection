      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "#16.\n",
    "numeric_cols = df.select_dtypes(include=\"number\").columns.tolist()\n",
    "numeric_cols.remove(\"Target\")\n",
    "\n",
    "corr = df[numeric_cols].corr()\n",
    "\n",
    "plt.figure(figsize=(10,8))\n",
    "\n",
    "sns.heatmap(\n",
    "    corr,\n",
    "    cmap=\"coolwarm\",\n",
    "    center=0,\n",
    "    vmin=-0.3,\n",
    "    vmax=0.3,\n",
    "    linewidths=0.5,\n",
    "    square=True\n",
    ")\n",
    "\n",
    "plt.title(\"Correlation Heatmap of Numeric Features\")\n",
    "plt.tight_layout()\n",
    "plt.savefig(os.path.join(plots_dir, \"correlation_heatmap.png\"),\n",
    "            dpi=300, bbox_inches=\"tight\")\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8bf8c4bc-69ea-4111-ae7f-d1da6d850780",
   "metadata": {},
   "source": [
    "**Observations:** Most PCA components show weak correlation with each other and with `Amount`/`Time`, consistent with PCA's decorrelation property. A handful of components stand out as exceptions:\n",
    "\n",
    "- **Correlated with Amount:** V7 and V20 show the strongest positive correlation; V6 shows a moderate positive correlation. V2 and V5 show the strongest negative correlation; V1 and V3 show a moderate negative correlation.\n",
    "- **Correlated with Time:** V3 shows the strongest negative correlation of any component — notably stronger than its (moderate) correlation with Amount. V11 and V25 show a moderate negative correlation with Time.\n",
    "\n",
    "These are meaningful exceptions to the otherwise weak feature relationships in this dataset. V7 in particular is referenced again in the SHAP-based error analysis (Notebook 6), where it is identified as the dominant feature explaining a specific high-value missed fraud case."
   ]
  },
